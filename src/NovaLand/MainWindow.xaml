<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NovaIsland.MainWindow" Title="NovaLand" Icon="Assets/AppIcon.ico" Width="244" Height="56" Topmost="True" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" FontFamily="Segoe UI Variable, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" Loaded="Window_Loaded" Closing="Window_Closing" Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseMove="Placement_PreviewMouseMove" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
 <Window.Resources>
  <ControlTemplate x:Key="SoftButtonTemplate" TargetType="Button">
   <Border x:Name="buttonSurface" CornerRadius="14" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
     <ContentPresenter.Resources>
      <Style TargetType="TextBlock">
       <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
       <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" />
       <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Style>
     </ContentPresenter.Resources>
    </ContentPresenter>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter TargetName="buttonSurface" Property="Opacity" Value="0.85" />
    </Trigger>
    <Trigger Property="IsPressed" Value="True">
     <Setter TargetName="buttonSurface" Property="Opacity" Value="0.6" />
    </Trigger>
    <Trigger Property="IsEnabled" Value="False">
     <Setter TargetName="buttonSurface" Property="Opacity" Value="0.3" />
    </Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True">
     <Setter TargetName="buttonSurface" Property="BorderBrush" Value="#796048" />
     <Setter TargetName="buttonSurface" Property="BorderThickness" Value="1" />
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="QuietInput" TargetType="TextBox">
   <Setter Property="Foreground" Value="#F0F0F3" />
   <Setter Property="CaretBrush" Value="#F0BB82" />
   <Setter Property="BorderBrush" Value="#303034" />
   <Setter Property="Padding" Value="12,10" />
   <Setter Property="FontSize" Value="12" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
   <Setter Property="SelectionBrush" Value="#444453" />
   <Setter Property="IsReadOnly" Value="False" />
   <Setter Property="Focusable" Value="True" />
   <Setter Property="IsTabStop" Value="True" />
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="BorderThickness" Value="0" />
   <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Input_PreviewMouseLeftButtonDown" />
   <EventSetter Event="GotKeyboardFocus" Handler="Input_GotKeyboardFocus" />
  </Style>
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource Chip}">
   <Setter Property="Template" Value="{StaticResource SoftButtonTemplate}" />
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="Foreground" Value="#96969C" />
   <Setter Property="FontSize" Value="10" />
   <Setter Property="Padding" Value="9,6" />
  </Style>
  <Style x:Key="WarmButton" TargetType="Button" BasedOn="{StaticResource Chip}">
   <Setter Property="Template" Value="{StaticResource SoftButtonTemplate}" />
   <Setter Property="Background" Value="#D7D7E3" />
   <Setter Property="Foreground" Value="#18181D" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="FontSize" Value="11" />
   <Setter Property="Padding" Value="15,9" />
  </Style>
  <Style x:Key="TimeArrow" TargetType="Button" BasedOn="{StaticResource GhostButton}">
   <Setter Property="Padding" Value="6,4" />
   <Setter Property="Height" Value="22" />
   <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <DataTemplate x:Key="ClipboardTextRow">
   <Border Background="#1C1C1E" CornerRadius="16" Padding="11" Margin="0,0,0,7" BorderBrush="#2A2A30" BorderThickness="0.5">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
     </Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
      <TextBlock Text="{Binding Preview}" FontSize="12" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Style="{StaticResource Chip}" Click="PinClipboard_Click" Width="29" Height="28" Padding="6" ToolTip="{Binding PinHint}" Margin="0,0,5,0">
       <Path Data="M9,3 L15,3 14,9 18,13 13,13 12,21 11,13 6,13 10,9 Z" Stroke="{Binding PinColor}" StrokeThickness="1.5" Width="13" Height="18" Stretch="Uniform" />
      </Button>
      <Button Content="Kopyala" Style="{StaticResource AccentButton}" Padding="9,6" Click="CopyClipboard_Click" />
     </StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="ClipboardImageRow">
   <Border Background="#1C1C1E" CornerRadius="16" Padding="10" Margin="0,0,0,7" BorderBrush="#2A2A30" BorderThickness="0.5">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="89" />
      <ColumnDefinition Width="*" />
     </Grid.ColumnDefinitions>
     <Button Click="PreviewImage_Click" Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,9,0" ToolTip="Görseli büyüt" AutomationProperties.Name="Görseli önizle">
      <Image Source="{Binding Thumbnail}" Width="78" Height="70" Stretch="Uniform" />
     </Button>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,3,0,6" />
      <StackPanel Orientation="Horizontal">
       <Button Style="{StaticResource Chip}" Click="PinClipboard_Click" Width="29" Height="28" Padding="6" ToolTip="{Binding PinHint}" Margin="0,0,5,0">
        <Path Data="M9,3 L15,3 14,9 18,13 13,13 12,21 11,13 6,13 10,9 Z" Stroke="{Binding PinColor}" StrokeThickness="1.5" Width="13" Height="18" Stretch="Uniform" />
       </Button>
       <Button Content="Görseli kopyala" Click="CopyImage_Click" Style="{StaticResource AccentButton}" Padding="9,5" FontSize="10" />
      </StackPanel>
     </StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
  <Style x:Key="OutputRowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="surface" CornerRadius="12" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#2A2A30"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.6"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.4"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderThickness" Value="1"/><Setter TargetName="surface" Property="BorderBrush" Value="#74747C"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DockTab" TargetType="Button" BasedOn="{StaticResource Chip}">
   <!-- WPF shows this adorner only for keyboard navigation, not mouse scrubbing. -->
   <Setter Property="FocusVisualStyle"><Setter.Value><Style TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
     <Border CornerRadius="15" BorderBrush="#777780" BorderThickness="1"/>
    </ControlTemplate></Setter.Value></Setter>
   </Style></Setter.Value></Setter>
   <Setter Property="Width" Value="36" />
   <Setter Property="Height" Value="34" />
   <Setter Property="Padding" Value="0" />
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
   <Setter Property="FontSize" Value="15" />
   <Setter Property="Margin" Value="2,0" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="dockTouch" CornerRadius="15" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="dockTouch" Property="Background" Value="#0CFFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DockActive" TargetType="Button" BasedOn="{StaticResource DockTab}">
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="Foreground" Value="White" />
  </Style>
 </Window.Resources>
 <Grid x:Name="IslandRoot" Margin="12,0,12,12">
  <Border x:Name="Shell" MouseEnter="Shell_MouseEnter" MouseLeave="Shell_MouseLeave" CornerRadius="0,0,22,22" Background="#101012" BorderThickness="0,0,0,0.5" BorderBrush="#303036">
