     <Path x:Name="NoticeIcon" Grid.Column="0" Data="M5,17 L19,17 17,14 17,9 A5,5 0 0 0 7,9 L7,14 Z M10,20 A2,2 0 0 0 14,20" Stroke="#F0BB82" StrokeThickness="1.8" Width="19" Height="21" Stretch="Uniform" Margin="0,0,11,0" Visibility="Collapsed" />
     <Border x:Name="MiniArtwork" Width="25" Height="25" CornerRadius="7" Background="#202022" Margin="0,0,11,0" Visibility="Collapsed">
      <Grid>
