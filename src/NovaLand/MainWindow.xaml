               <Path Data="M4,9 L8,13 15,5" Stroke="#10140C" StrokeThickness="2" Width="11" Height="9" Stretch="Uniform">
                <Path.Style>
                 <Style TargetType="Path">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                   <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                   </DataTrigger>
                  </Style.Triggers>
                 </Style>
                </Path.Style>
               </Path>
              </Button>
              <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="5,2,9,0" FontSize="12">
               <TextBlock.Style>
                <Style TargetType="TextBlock">
                 <Setter Property="Foreground" Value="#E5E5E9" />
                 <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                   <Setter Property="TextDecorations" Value="Strikethrough" />
                   <Setter Property="Foreground" Value="#737379" />
                   <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.24"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                   <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                  </DataTrigger>
                 </Style.Triggers>
                </Style>
               </TextBlock.Style>
              </TextBlock>
              <Button Grid.Column="2" Width="28" Height="28" Padding="6" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Click="TodoFocus_Click" ToolTip="Bu göreve odaklan" AutomationProperties.Name="Bu göreve odaklan"><Path Data="M8,3 L8,1 14,1 14,3 M11,7 L11,12 14,14 M11,4 A8,8 0 1 1 10.99,4" Stroke="#A1A1AA" StrokeThickness="1.5" Width="16" Height="18" Stretch="Uniform"/></Button>
              <Button Grid.Column="3" Width="27" Height="25" Padding="6" Style="{StaticResource Chip}" Background="Transparent" VerticalAlignment="Top" ToolTip="Görevi sil" Click="TodoDelete_Click">
               <Path Data="M5,6 L19,6 M9,6 L9,3 15,3 15,6 M7,6 L8,21 16,21 17,6 M10,10 L10,17 M14,10 L14,17" Stroke="#8E8E93" StrokeThickness="1.6" Width="12" Height="15" Stretch="Uniform" />
              </Button>
             </Grid>
            </Border>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>
       </Grid>
      </Grid>
      <ScrollViewer x:Name="ControlsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
       <StackPanel Margin="0,12,0,8">
        <TextBlock Text="Kontroller" Style="{StaticResource PageTitle}" />

        <TextBlock Text="BAĞLI CİHAZLAR" Style="{StaticResource SectionLabel}" Margin="2,10,0,8"/>
        <Border x:Name="ConnectedAudioEmpty" Style="{StaticResource InsetCard}">
         <StackPanel><TextBlock Text="Kulaklık bağlantısı bekleniyor" FontSize="12"/><TextBlock Text="Bluetooth ses cihazların burada görünür." FontSize="10" Foreground="#74747D" Margin="0,5,0,0"/></StackPanel>
        </Border>
        <ItemsControl x:Name="ConnectedAudioList">
         <ItemsControl.ItemTemplate><DataTemplate>
          <Border Style="{StaticResource InsetCard}" Margin="0,0,0,6">
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Path Data="M3,13 L3,10 A9,9 0 0 1 21,10 L21,13 M3,12 L6,12 6,20 3,20 Z M18,12 L21,12 21,20 18,20 Z" Stroke="#C2C2CB" StrokeThickness="1.4" Width="21" Height="21" Stretch="Uniform" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="6,0,10,0"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="Bağlı" FontSize="9" Foreground="#87A180" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip="{Binding BatteryHint, Mode=OneWay}">
             <Grid Width="28" Height="15" VerticalAlignment="Center" IsHitTestVisible="False">
              <Border Width="23" Height="13" CornerRadius="3" BorderThickness="1" BorderBrush="#A1A1A6" HorizontalAlignment="Left" VerticalAlignment="Center">
               <Border Width="{Binding BatteryFillWidth, Mode=OneWay}" Height="7" Margin="2,0,0,0" CornerRadius="1.5" Background="{Binding BatteryColor, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Center" Loaded="ConnectedBatteryFill_Loaded" IsVisibleChanged="ConnectedBatteryFill_IsVisibleChanged"/>
              </Border>
              <Border Width="2" Height="5" CornerRadius="1" Background="#A1A1A6" HorizontalAlignment="Right" Margin="0,0,1,0" VerticalAlignment="Center"/>
             </Grid>
             <TextBlock Text="{Binding BatteryLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding BatteryColor, Mode=OneWay}" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
           </Grid>
          </Border>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="SES ÇIKIŞI" Style="{StaticResource SectionLabel}" Margin="2,18,0,9"/>
        <Border Style="{StaticResource InsetCard}" Padding="4">
         <StackPanel>
          <TextBlock x:Name="OutputAudioEmpty" Text="Ses çıkışı bulunamadı." FontSize="10" Foreground="#777780" Margin="10"/>
          <ItemsControl x:Name="OutputAudioList">
           <ItemsControl.ItemTemplate><DataTemplate>
            <Button Click="OutputAudio_Click" Style="{StaticResource OutputRowButton}" HorizontalContentAlignment="Stretch" Padding="10,8" ToolTip="Varsayılan ses çıkışı olarak kullan">
             <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
              <Path Data="M3,8 L7,8 12,4 12,20 7,16 3,16 Z M16,7 Q23,12 16,17" Stroke="#A6A6AF" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="5,0,8,0"/>
              <Path Grid.Column="2" Data="M2,7 L6,11 14,3" Stroke="#D7D7E3" StrokeThickness="1.6" Width="12" Height="9" Stretch="Uniform" VerticalAlignment="Center" Visibility="{Binding SelectedVisibility}"/>
             </Grid>
            </Button>
           </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
        </Border>
        <TextBlock Text="Windows’un varsayılan ses çıkışı." FontSize="9" Foreground="#666670" Margin="3,7,0,0"/>
        <TextBlock Text="EKRAN" Style="{StaticResource SectionLabel}" Margin="2,12,0,8" />
        <Border Style="{StaticResource InsetCard}">
         <StackPanel>
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="29" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
           </Grid.ColumnDefinitions>
           <Path Data="M17,12 A5,5 0 1 1 7,12 A5,5 0 1 1 17,12 M12,1 L12,4 M12,20 L12,23 M1,12 L4,12 M20,12 L23,12 M4,4 L6,6 M18,18 L20,20 M4,20 L6,18 M18,6 L20,4" Stroke="#BFC0C6" StrokeThickness="1.3" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
           <TextBlock Grid.Column="1" Text="Parlaklık" FontSize="12" VerticalAlignment="Center" />
           <TextBlock x:Name="BrightnessValue" Grid.Column="2" FontSize="10" Foreground="#A1A1AB" VerticalAlignment="Center" />
          </Grid>
          <Slider x:Name="BrightnessSlider" Style="{StaticResource ControlSlider}" Minimum="0" Maximum="100" Value="50" Margin="0,8,0,0" ValueChanged="BrightnessSlider_ValueChanged" AutomationProperties.Name="Ekran parlaklığı" />
          <TextBlock Text="Dahili ekran desteği donanıma bağlıdır." FontSize="9" Foreground="#666670" Margin="0,6,0,0" />
         </StackPanel>
        </Border>
        <Border Style="{StaticResource InsetCard}" Margin="0,8,0,0">
         <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Path Data="M17,3 A9,9 0 1 0 21,17 A10,10 0 0 1 17,3 Z" Stroke="#B8B8C0" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
           <TextBlock Grid.Column="1" Text="Ek karartma" FontSize="12" VerticalAlignment="Center"/>
           <TextBlock x:Name="ExtraDimValue" Grid.Column="2" Text="Kapalı" FontSize="10" Foreground="#A1A1AA" VerticalAlignment="Center"/>
          </Grid>
          <Slider x:Name="ExtraDimSlider" Style="{StaticResource ControlSlider}" Minimum="0" Maximum="70" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,7,0,0" ValueChanged="ExtraDim_ValueChanged" AutomationProperties.Name="Ek ekran karartması"/>
          <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="Gece için · tüm ekranlarda" FontSize="9" Foreground="#8E8E93" VerticalAlignment="Center"/>
           <Button Grid.Column="1" Content="Kapat" Style="{StaticResource GhostButton}" FontSize="10" Padding="6,3" Click="ExtraDimOff_Click"/>
          </Grid>
         </StackPanel>
        </Border>
        <Button Content="Windows ses ayarları ↗" Style="{StaticResource GhostButton}" FontSize="10" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SoundSettings_Click" />
       </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
       <StackPanel Margin="0,12,0,8">
        <StackPanel Orientation="Horizontal">
         <Image Source="Assets/Logo.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0"/>
         <TextBlock Text="NovaLand" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Küçük ayrıntılar, senin düzenin." FontSize="10" Foreground="#74747C" Margin="0,5,0,20" />
        <TextBlock Text="GENEL" Style="{StaticResource SectionLabel}" Margin="2,12,0,8" />
        <Border Style="{StaticResource InsetCard}" Padding="14,3">
         <StackPanel>
          <CheckBox x:Name="AutoHideCheck" Content="Üst kenara çekilerek gizlen" Checked="AutoHideCheck_Changed" Unchecked="AutoHideCheck_Changed" Margin="0" />
          <Border Height="0.5" Background="#252529" />
          <CheckBox x:Name="StayTopCheck" Content="Diğer pencerelerin önünde tut" Checked="StayTopCheck_Changed" Unchecked="StayTopCheck_Changed" Margin="0" />
          <Border Height="0.5" Background="#252529" />
          <CheckBox x:Name="StartupCheck" Content="Windows ile başlat" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed" Margin="0" />
         </StackPanel>
        </Border>
        <TextBlock Text="GÜNLÜK KULLANIM" Style="{StaticResource SectionLabel}" Margin="2,12,0,8" />
        <Border Style="{StaticResource InsetCard}" Padding="14,3">
         <StackPanel>
          <CheckBox x:Name="CaptureClipboardCheck" Content="Metin, görsel ve dosya geçmişini tut" Checked="CaptureClipboardCheck_Changed" Unchecked="CaptureClipboardCheck_Changed" Margin="0" />
          <Border Height="0.5" Background="#252529" />
          <CheckBox x:Name="WaterCheck" Content="45 dakikada bir su molası" Checked="WaterCheck_Changed" Unchecked="WaterCheck_Changed" Margin="0" />
         </StackPanel>
        </Border>
        <TextBlock Text="Son kopyalananlar bu oturumda kalır.&#10;Sabitlediklerin saklanır." Foreground="#686872" FontSize="9" TextWrapping="Wrap" Margin="3,12,0,16" />
        <Expander Style="{StaticResource QuietDisclosure}" Margin="0,8,0,0">
         <Expander.Header>
          <TextBlock Text="Tarayıcı bağlantısı" Foreground="#8C8C95" FontSize="10" />
         </Expander.Header>
         <StackPanel>
          <TextBlock x:Name="BrowserAudioStatus" FontSize="10" Foreground="#A4B69E" Margin="0,0,0,5"/>
          <TextBlock x:Name="BrowserAudioHelp" FontSize="10" Foreground="#777780" TextWrapping="Wrap" Margin="0,0,0,9"/>
          <TextBlock Text="Ses eklentisini bu bilgisayarla eşleştir." FontSize="10" Foreground="#777780" TextWrapping="Wrap" Margin="0,0,0,9" />
          <WrapPanel>
           <Button Content="Kodu kopyala" Style="{StaticResource Chip}" FontSize="10" Padding="10,7" Click="BrowserPair_Click" Margin="0,0,6,4" />
           <Button Content="Eklenti klasörü ↗" Style="{StaticResource GhostButton}" FontSize="10" Padding="10,7" Click="BrowserExtension_Click" Margin="0,0,0,4" />
          </WrapPanel>
         </StackPanel>
        </Expander>

        <TextBlock Text="GÜNCELLEMELER" Style="{StaticResource SectionLabel}" Margin="2,18,0,8" />
        <Border Style="{StaticResource InsetCard}" Padding="14">
         <StackPanel>
          <TextBlock x:Name="UpdateVersionText" Foreground="#DEDEE4" FontSize="11" FontWeight="Medium"/>
          <TextBlock x:Name="UpdateStatusText" Text="Yeni sürümler otomatik kontrol edilir." Foreground="#83838C" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,12"/>
          <WrapPanel>
           <Button x:Name="CheckUpdateButton" Content="Güncellemeleri denetle" Style="{StaticResource GhostButton}" FontSize="10" Padding="9,7" Click="CheckUpdate_Click" Margin="0,0,6,0"/>
           <Button x:Name="ApplyUpdateButton" Content="Güncelle ve yeniden başlat" Style="{StaticResource Chip}" FontSize="10" Padding="10,7" Click="ApplyUpdate_Click" Visibility="Collapsed"/>
          </WrapPanel>
         </StackPanel>
        </Border>
        <Button Content="Uygulamadan çık" Style="{StaticResource GhostButton}" Foreground="#D58A8A" FontSize="11" HorizontalAlignment="Left" Click="Quit_Click" />
       </StackPanel>
      </ScrollViewer>
     </Grid>
     <Image x:Name="PreviousPage" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"><Image.RenderTransform><TranslateTransform x:Name="PreviousPageTranslate"/></Image.RenderTransform></Image>
