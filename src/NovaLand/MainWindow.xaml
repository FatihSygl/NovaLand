       </Button>
       <Button x:Name="SettingsTab" Tag="Settings" Style="{StaticResource DockTab}" Click="Tab_Click" ToolTip="Ayarlar">
        <Path Data="M10,2 L14,2 14.7,5 16.3,5.7 19,4.2 21.8,7 20.3,9.7 21,11.3 24,12 24,16 21,16.7 20.3,18.3 21.8,21 19,23.8 16.3,22.3 14.7,23 14,26 10,26 9.3,23 7.7,22.3 5,23.8 2.2,21 3.7,18.3 3,16.7 0,16 0,12 3,11.3 3.7,9.7 2.2,7 5,4.2 7.7,5.7 9.3,5 Z M16,14 A4,4 0 1 1 8,14 A4,4 0 1 1 16,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" />
       </Button>

      </StackPanel>
      </Grid>
     </Border>
     <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="9" Foreground="#9797A2" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
   </Grid>
  </Border>
 </Grid>
