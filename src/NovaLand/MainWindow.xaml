 <Button x:Name="PlacementLockButton" Style="{StaticResource GhostButton}" Width="24" Height="26" Padding="5" Click="PlacementLock_Click" ToolTip="Konumu kilitle" AutomationProperties.Name="Konum kilidi"><Path x:Name="PlacementLockIcon" Data="M6,10 L18,10 18,21 6,21 Z M8,10 V6 A4,4 0 0 1 16,6 M12,14 V17" Stroke="#787882" StrokeThickness="1.5" Width="12" Height="14" Stretch="Uniform"/></Button>
 <Button Style="{StaticResource GhostButton}" Width="24" Height="26" Padding="5" Click="PlacementReset_Click" ToolTip="Konumu sıfırla · üst ortaya dön" AutomationProperties.Name="Konumu sıfırla"><Path Data="M5,7 A8,8 0 1 1 4,15 M5,2 L5,7 10,7" Stroke="#787882" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"/></Button>
</StackPanel>
