       <Canvas IsHitTestVisible="False"><Border x:Name="DockSelection" Width="36" Height="34" CornerRadius="16" Background="#39393F" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><TransformGroup><ScaleTransform x:Name="DockSelectionScale"/><TranslateTransform x:Name="DockSelectionTranslate" X="2"/></TransformGroup></Border.RenderTransform></Border></Canvas>
      <StackPanel x:Name="DockButtons" Orientation="Horizontal">
       <Button x:Name="MusicTab" Tag="Music" Style="{StaticResource DockActive}" Click="Tab_Click" ToolTip="Ana sayfa">
        <Path Data="M9,17 V5 L20,3 V15 M9,8 L20,6 M9,17 C9,19 3,21 3,17 C3,14 9,14 9,17 M20,15 C20,17 14,19 14,15 C14,12 20,12 20,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" />
       </Button>
